@model IEnumerable<Order>
@{
    ViewData["Title"] = "Danh sách đơn hàng";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Đơn hàng khách hàng</h3>
        <div class="card-tools">
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="fas fa-plus"></i> Thêm đơn hàng
            </a>
        </div>
    </div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Khách hàng</th>
                    <th>Ngày đặt</th>
                    <th>Trạng thái</th>
                    <th class="text-right">Tổng tiền</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">Chưa có đơn hàng.</td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>#@item.Id</td>
                        <td>@item.Customer?.Fullname</td>
                        <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span class="badge badge-info">@item.Status</span></td>
                        <td class="text-right">@item.TotalAmount.ToString("N0") đ</td>
                        <td class="text-right">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-xs btn-default" title="Chi tiết">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-xs btn-warning" title="Sửa">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-xs btn-danger" title="Xóa">
                                <i class="fas fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
