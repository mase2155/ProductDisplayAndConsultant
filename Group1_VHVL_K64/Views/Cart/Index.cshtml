@model IEnumerable<Group1_VHVL_K64.Models.CartLineDisplay>
@{
    ViewData["Title"] = "Giỏ Hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";

    decimal grandTotal = 0;
    foreach (var line in Model)
    {
        grandTotal += line.LineTotal;
    }

    int totalItems = Model.Sum(x => x.Quantity);
}

<section id="cart-banner">
    <div class="cart-banner-image">
        <img src="~/img/san_pham/banner1.jpg" alt="Banner giỏ hàng">
    </div>
</section>

<section id="cart-page">
    <div class="container">
        @if (TempData["CartErrorMessage"] != null)
        {
            <div class="alert alert-danger mb-4">@TempData["CartErrorMessage"]</div>
        }
        @if (TempData["CartSuccessMessage"] != null)
        {
            <div class="alert alert-success mb-4">@TempData["CartSuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger mb-4">@TempData["ErrorMessage"]</div>
        }
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mb-4">@TempData["SuccessMessage"]</div>
        }

        @if (!Model.Any())
        {
            <div class="cart-empty">
                <div class="cart-empty-icon">
                    <i class="fa-solid fa-cart-shopping"></i>
                </div>
                <h2>Giỏ hàng đang trống</h2>
                <p>Hãy chọn sản phẩm yêu thích và thêm vào giỏ để tiếp tục mua sắm.</p>
                <a asp-controller="Product" asp-action="Index" class="btn-cart-primary">
                    Xem sản phẩm
                </a>
            </div>
        }
        else
        {
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="cart-panel-toolbar">
                        <form asp-controller="Cart" asp-action="ClearCart" method="post" class="d-inline"
                              onsubmit="return confirm('Bạn có chắc muốn xóa toàn bộ sản phẩm trong giỏ hàng?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-clear-all-cart">
                                <i class="fa-regular fa-trash-can"></i> Xóa toàn bộ giỏ hàng
                            </button>
                        </form>
                    </div>
                    <div class="cart-panel">
                        <div class="cart-panel-head d-none d-md-grid">
                            <span>Sản phẩm</span>
                            <span class="text-center">Đơn giá</span>
                            <span class="text-center">Số lượng</span>
                            <span class="text-end">Thành tiền</span>
                        </div>

                        @foreach (var item in Model)
                        {
                            <div class="cart-row" data-product-id="@item.ProductId">
                                <div class="cart-product">
                                    <div class="cart-product-thumb">
                                        <img src="@item.Urlimage" alt="@item.Name">
                                    </div>
                                    <div class="cart-product-info">
                                        <h3>@item.Name</h3>
                                        <form asp-controller="Cart" asp-action="RemoveFromCart" method="post" class="d-inline"
                                              onsubmit="return confirm('Bạn có chắc muốn xóa sản phẩm này khỏi giỏ hàng?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button type="submit" class="btn-cart-remove">
                                                <i class="fa-regular fa-trash-can"></i> Xóa
                                            </button>
                                        </form>
                                    </div>
                                </div>

                                <div class="cart-unit-price" data-label="Đơn giá">
                                    @item.UnitPrice.ToString("N0") đ
                                </div>

                                <div class="cart-quantity" data-label="Số lượng">
                                    <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="qty-control-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <div class="qty-control">
                                            <button type="submit" name="quantity" value="@(item.Quantity - 1)" class="qty-btn"
                                                    @(item.Quantity <= 1 ? "disabled" : null) aria-label="Giảm số lượng">
                                                <i class="fa-solid fa-minus"></i>
                                            </button>
                                            <span class="qty-display">@item.Quantity</span>
                                            <button type="submit" name="quantity" value="@(item.Quantity + 1)" class="qty-btn"
                                                    @(item.Quantity >= 99 ? "disabled" : null) aria-label="Tăng số lượng">
                                                <i class="fa-solid fa-plus"></i>
                                            </button>
                                        </div>
                                    </form>
                                </div>

                                <div class="cart-line-total text-end" data-label="Thành tiền">
                                    <span class="line-total-value">@item.LineTotal.ToString("N0")</span> đ
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="cart-summary">
                        <h2>Tóm tắt đơn hàng</h2>

                        <div class="summary-row">
                            <span>Tạm tính (@totalItems sản phẩm)</span>
                            <span><span id="cart-grand-total">@grandTotal.ToString("N0")</span> đ</span>
                        </div>

                        <div class="summary-row summary-shipping">
                            <span>Phí vận chuyển</span>
                            <span class="text-muted">Liên hệ sau</span>
                        </div>

                        <div class="summary-divider"></div>

                        <div class="summary-row summary-total">
                            <span>Tổng cộng</span>
                            <span class="summary-total-price">
                                <span id="cart-grand-total-footer">@grandTotal.ToString("N0")</span> đ
                            </span>
                        </div>

                        @if (User.IsInRole("User"))
                        {
                            <form asp-action="Checkout" method="post" class="mb-2">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-cart-primary w-100">
                                    Tiến hành thanh toán
                                </button>
                            </form>
                            <p class="cart-checkout-hint">Đơn sẽ gửi tới Admin với thông tin tài khoản và sản phẩm trong giỏ.</p>
                        }
                        else if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <p class="cart-checkout-hint text-muted">Tài khoản Admin không đặt hàng qua giỏ khách.</p>
                        }
                        else
                        {
                            <a asp-controller="Account"
                               asp-action="Login"
                               asp-route-returnUrl="@Url.Action("Index", "Cart")"
                               class="btn-cart-primary w-100 d-block text-center mb-2">
                                Đăng nhập để thanh toán
                            </a>
                        }

                        <a asp-controller="Product" asp-action="Index" class="btn-cart-outline w-100">
                            Tiếp tục mua sắm
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/cart.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var totalItems = @totalItems;
            var badge = document.querySelector('.cart-count-badge');
            if (badge && totalItems > 0) {
                badge.textContent = totalItems;
                badge.style.display = 'inline-flex';
            }
        });
    </script>
}
