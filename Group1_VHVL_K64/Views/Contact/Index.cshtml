@model ContactFormViewModel
@{
	ViewData["Title"] = "Liên Hệ";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<section id="banner-gioi_thieu">
    <div class="imgOfBanner">
        <img src="img/lien_he/banner.jpg" alt="banner-lien_he">
    </div>
    <div class="contentOfBanner">
        <img src="img/lien_he/logoBanner.png" alt="logoOfBanner">
        <h2>Liên hệ</h2>
    </div>
</section>
<section id="introduce">
    <div class="container">
        <div class="content_big row">
            <div class="image col-6">
                <img src="img/lien_he/image-introduce.jpg"
                     alt="image-introduce">
            </div>
            <div class="content col-6">
                <h3>Liên hệ với chúng tôi</h3>
                <div class="form-contact">
                    @if (TempData["ContactSuccessMessage"] != null)
                    {
                        <div class="alert alert-success mb-3">@TempData["ContactSuccessMessage"]</div>
                    }

                    <form id="contactForm" asp-action="Index" asp-controller="Contact" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <input asp-for="FullName" class="form-control" placeholder="Họ Và Tên" />
                            <span asp-validation-for="FullName" class="text-danger" style="font-size: 0.875rem;"></span>
                        </div>

                        <div class="mb-3">
                            <input asp-for="Email" class="form-control" placeholder="Email" />
                            <span asp-validation-for="Email" class="text-danger" style="font-size: 0.875rem;"></span>
                        </div>

                        <div class="mb-3">
                            <input asp-for="Phone" class="form-control" placeholder="Số Điện Thoại" />
                            <span asp-validation-for="Phone" class="text-danger" style="font-size: 0.875rem;"></span>
                        </div>

                        <div class="mb-3">
                            <input asp-for="Content" class="form-control" placeholder="Nội Dung" />
                            <span asp-validation-for="Content" class="text-danger" style="font-size: 0.875rem;"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">Gửi</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
@section Styles {
    <link rel="stylesheet" href="~/css/contact.css?v=@DateTime.Now.Ticks" />
}

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
