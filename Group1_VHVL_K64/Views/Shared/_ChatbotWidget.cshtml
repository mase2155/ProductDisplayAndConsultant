<div id="chatbot-root">
    <button type="button" id="chatbot-toggle" aria-label="Mở trợ lý tư vấn">
        <i class="fa-solid fa-comments"></i>
    </button>

    <div id="chatbot-panel" class="chatbot-panel-hidden" aria-hidden="true">
        <div class="chatbot-header">
            <span>Hoàng Hoan — Tư vấn</span>
            <button type="button" id="chatbot-close" aria-label="Đóng">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div id="chatbot-messages" class="chatbot-messages"></div>
        <div id="chatbot-options" class="chatbot-options"></div>
    </div>
</div>
