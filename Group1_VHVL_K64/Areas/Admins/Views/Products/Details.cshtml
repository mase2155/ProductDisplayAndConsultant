@model Product
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">@Model.Name</h3>
        <div class="card-tools">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">
                <i class="fas fa-edit"></i> Sửa
            </a>
            <a asp-action="Index" class="btn btn-default btn-sm">Quay lại</a>
        </div>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Mã</dt>
            <dd class="col-sm-9">#@Model.Id</dd>
            <dt class="col-sm-3">Danh mục</dt>
            <dd class="col-sm-9">@(Model.Category?.Name ?? "—")</dd>
            <dt class="col-sm-3">Giá niêm yết</dt>
            <dd class="col-sm-9">@Model.Price.ToString("N0") đ</dd>
            <dt class="col-sm-3">Giá khuyến mãi</dt>
            <dd class="col-sm-9">@(Model.NewPrice.HasValue ? Model.NewPrice.Value.ToString("N0") + " đ" : "—")</dd>
            <dt class="col-sm-3">Đánh giá</dt>
            <dd class="col-sm-9">@(Model.RateByStars?.ToString("0.0") ?? "—") / 5</dd>
            <dt class="col-sm-3">Ảnh</dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrWhiteSpace(Model.Urlimage))
                {
                    <img src="@Model.Urlimage" alt="" style="max-height: 120px;" />
                    <div><small class="text-muted">@Model.Urlimage</small></div>
                }
                else
                {
                    <span class="text-muted">—</span>
                }
            </dd>
            <dt class="col-sm-3">Mô tả</dt>
            <dd class="col-sm-9" style="white-space: pre-wrap;">@(Model.Details ?? "—")</dd>
        </dl>
    </div>
</div>
