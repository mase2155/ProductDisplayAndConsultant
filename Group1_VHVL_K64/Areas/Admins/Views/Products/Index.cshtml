@model IEnumerable<Product>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Quản lý sản phẩm";
    IEnumerable<SelectListItem>? filterCategories = ViewData["CategoryFilterOptions"] as IEnumerable<SelectListItem>;
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Danh sách sản phẩm</h3>
        <div class="card-tools">
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="fas fa-plus"></i> Thêm sản phẩm
            </a>
        </div>
    </div>
    <div class="card-body pb-0">
        <form asp-action="Index" method="get" class="form-inline mb-3">
            <label class="mr-2 mb-2 mb-md-0" for="categoryId">Danh mục</label>
            <select name="categoryId" id="categoryId" asp-items="filterCategories" class="form-control form-control-sm mr-2 mb-2 mb-md-0" style="min-width: 200px;" onchange="this.form.submit()">
            </select>
            <noscript>
                <button type="submit" class="btn btn-sm btn-default mb-2">Lọc</button>
            </noscript>
            @if (Context.Request.Query.ContainsKey("categoryId") && !string.IsNullOrEmpty(Context.Request.Query["categoryId"]))
            {
                <a asp-action="Index" class="btn btn-sm btn-default mb-2">Xóa bộ lọc</a>
            }
        </form>
    </div>
    <div class="card-body table-responsive p-0 pt-0">
        <table class="table table-hover text-nowrap">
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Ảnh</th>
                    <th>Tên</th>
                    <th>Danh mục</th>
                    <th class="text-right">Giá</th>
                    <th class="text-right">Giá KM</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">Chưa có sản phẩm.</td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>#@item.Id</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.Urlimage))
                            {
                                <img src="@item.Urlimage" alt="" style="max-height: 40px; max-width: 60px; object-fit: cover;" />
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>@item.Name</td>
                        <td>@(item.Category?.Name ?? "—")</td>
                        <td class="text-right">@item.Price.ToString("N0") đ</td>
                        <td class="text-right">
                            @(item.NewPrice.HasValue ? item.NewPrice.Value.ToString("N0") + " đ" : "—")
                        </td>
                        <td class="text-right">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-xs btn-default" title="Chi tiết">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-xs btn-warning" title="Sửa">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-xs btn-danger" title="Xóa">
                                <i class="fas fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
