@{
	ViewData["Title"] = "Liên Hệ";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<section id="banner-gioi_thieu">
    <div class="imgOfBanner">
        <img src="img/lien_he/banner.jpg" alt="banner-lien_he">
    </div>
    <div class="contentOfBanner">
        <img src="img/lien_he/logoBanner.png" alt="logoOfBanner">
        <h2>Liên hệ</h2>
    </div>
</section>
<section id="introduce">
    <div class="container">
        <div class="content_big row">
            <div class="image col-6">
                <img src="img/lien_he/image-introduce.jpg"
                     alt="image-introduce">
            </div>
            <div class="content col-6">
                <h3>liên hệ với chúng tôi</h3>
                <div class="form-contact">
                    <form action="javascript:void(0);" novalidate class="needs-validation">
                        <div class="mb-3">
                            <input type="text" name="Username" class="form-control" placeholder="Họ Và Tên" required>
                        </div>

                        <div class="mb-3">
                            <input type="email" name="Email" class="form-control" placeholder="Email" required>
                        </div>

                        <div class="mb-3">
                            <input type="tel" name="PhoneNumber" class="form-control" placeholder="Số Điện Thoại" required>
                        </div>

                        <div class="mb-3">
                            <input type="text" name="Content" class="form-control" placeholder="Nội Dung" required>
                        </div>

                        <button type="submit" class="btn">Gửi</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
@section Styles {
    <link rel="stylesheet" href="~/css/contact.css" />
}