                    </a>
                </div>
                <div class="col-md-3">
                    <a href="#">
                        <img src="img/trang_chu/p-bep.jpg" alt="p-bep">
                        <p>Phòng bếp</p>
                    </a>
                </div>
                <div class="col-md-3">
