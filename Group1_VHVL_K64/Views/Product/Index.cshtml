@model IEnumerable<Group1_VHVL_K64.Models.DBModel.Category>
@{
	ViewData["Title"] = "Sản Phẩm";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<section id="banner">
    <div class="banner-item active">
        <img src="~/img/san_pham/banner1.jpg" alt="banner1">
        <div class="banner-btn-click">
            <a asp-controller="Contact" asp-action="Index">mua ngay</a>
        </div>
    </div>

    <div class="banner-item">
        <img src="~/img/san_pham/banner2.png" alt="banner2">
    </div>

    <button class="nav-btn prev" id="prevBtn">&#10094;</button>
    <button class="nav-btn next" id="nextBtn">&#10095;</button>

    <div class="dots-container">
        <span class="dot active"></span>
        <span class="dot"></span>
    </div>
</section>
<section id="content">
    <div class="container">
        <!-- Vòng lặp 1 : Category-->
        @foreach (var cat in Model)
        {
            <div class="table-product">
                <div class="title">
                    <div class="row">
                        <div class="col-8">
                            <h2>@cat.Name</h2>
                        </div>
                        <div class="col-4">
                            <a asp-area="" asp-action="">Xem tất cả</a>
                        </div>
                    </div>
                </div>

                <div class="list-product row mb-5">
                    <!-- Vòng lặp 2 : Product được đặt ở đây để mỗi item là một cột riêng biệt -->
                    @foreach (var item in cat.Products)
                    {
                        <div class="col-12 col-md-6 col-lg-3 mb-4">
                            <div class="productCard">
                                <img src="@item.Urlimage" alt="phongkhach_img1">
                                <h4>@item.Name</h4>
                                <div class="details">@item.Details</div>
                                <div class="price">
                                    @item.Price
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>
@section Styles {
    <link rel="stylesheet" href="~/css/product.css" />
}
@section Scripts {
    <script src="~/js/transferBanner_product.js"></script>
}