@{
	ViewData["Title"] = "Đối Tác";
	Layout = "~/Views/Shared/_Layout.cshtml";
};

<section id="banner-gioi_thieu">
    <div class="imgOfBanner">
        <img src="~/img/doi_tac/banner.jpg" alt="banner">
    </div>
    <div class="contentOfBanner">
        <img src="~/img/doi_tac/logo-banner.png" alt="logo">
        <h2>Đối Tác</h2>
    </div>
</section>
<section id="introduce-partner">
    <div class="container">
        <div class="item-introduce row align-items-center mb-5">
            <div class="img-item">
                <img class="w-100"
                     src="~/img/doi_tac/logo_partner-introduce/intro_vinpearl.jpg"
                     alt="intro_vinpearl">
            </div>
            <div class="content-item">
                <h3>công ty cổ phần vinpearl</h3>
                <p>
                    Tại Mường Thanh, chúng tôi mời bạn cùng khởi hành
                    chuyến
                    đi tìm về không gian thanh thản chứa đựng những
                    nét
                    văn
                    hóa mang đậm tinh thần bản sắc Việt, nơi con
                    người
                    gắn
                    kết và thân ái gửi trao nhau tình cảm chân
                    thành.
                </p>
            </div>
        </div>
        <div class="item-introduce">
            <div class="img-item">
                <img class="w-100"
                     src="~/img/doi_tac/logo_partner-introduce/intro_muongthanh.jpg"
                     alt="intro_muongthanh">
            </div>
            <div class="content-item ">
                <h3>tập đoàn khách sạn mường thanh</h3>
                <p>
                    Tại Mường Thanh, chúng tôi mời bạn cùng khởi hành
                    chuyến
                    đi tìm về không gian thanh thản chứa đựng những
                    nét
                    văn
                    hóa mang đậm tinh thần bản sắc Việt, nơi con
                    người
                    gắn
                    kết và thân ái gửi trao nhau tình cảm chân
                    thành.
                </p>
            </div>
        </div>
        <div class="item-introduce">
            <div class="img-item">
                <img class="w-100"
                     src="~/img/doi_tac/logo_partner-introduce/intro_sheraton.jpg"
                     alt="intro_sheraton">
            </div>
            <div class="content-item">
                <h3>sheraton hanoi hotel</h3>
                <p>
                    Situated on the shores of Hanoi's West Lake and
                    surrounded by its many local attractions,
                    Sheraton
                    Hanoi
                    Hotel is just a quick drive to the bustling
                    downtown
                    of
                    Hanoi City. Explore the nearby Old Quarter, home
                    to
                    Hoan
                    Kiem Lake, Hanoi Opera House and exceptional
                    boutiques.
                </p>
            </div>
        </div>
        <div class="item-introduce">
            <div class="img-item">
                <img class="w-100"
                     src="~/img/doi_tac/logo_partner-introduce/intro_thecoffeehouse.jpg"
                     alt="intro_thecoffeehouse">
            </div>
            <div class="content-item">
                <h3>the coffee house</h3>
                <p>
                    Tại The Coffee House, chúng tôi luôn trân trọng
                    những
                    câu
                    chuyện và đề cao giá trị Kết nối con người.
                    Chúng
                    tôi
                    mong muốn The Coffee House sẽ trở thành “Nhà Cà
                    Phê",
                    nơi mọi người xích lại gần nhau và tìm thấy niềm
                    vui, sự
                    sẻ chia thân tình bên những tách cà phê đượm
                    hương,
                    chất
                    lượng.
                </p>
            </div>
        </div>
        <div class="item-introduce">
            <div class="img-item">
                <img class="w-100"
                     src="~/img/doi_tac/logo_partner-introduce/intro_marvella.jpg"
                     alt="intro_marvella">
            </div>
            <div class="content-item">
                <h3>marvella hotel nha trang</h3>
                <p>
                    Marvella một thương hiệu khách sạn 4 sao mới xây
                    dựng theo phong cách tân cổ điển, sang trọng.
                </p>
            </div>
        </div>
    </div>
</section>
@section Styles {
    <link rel="stylesheet" href="~/css/partner.css" /> }