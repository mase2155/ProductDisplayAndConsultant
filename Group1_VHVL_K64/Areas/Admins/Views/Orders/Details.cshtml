@model Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.Id;
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Thông tin đơn</h3>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Khách hàng</dt>
                    <dd class="col-sm-8">@Model.Customer?.Fullname (@Model.Customer?.Email)</dd>

                    <dt class="col-sm-4">Ngày đặt</dt>
                    <dd class="col-sm-8">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-4">Trạng thái</dt>
                    <dd class="col-sm-8"><span class="badge badge-info">@Model.Status</span></dd>

                    <dt class="col-sm-4">Điện thoại</dt>
                    <dd class="col-sm-8">@(Model.Phone ?? "—")</dd>

                    <dt class="col-sm-4">Địa chỉ giao</dt>
                    <dd class="col-sm-8">@(Model.ShippingAddress ?? "—")</dd>

                    <dt class="col-sm-4">Ghi chú</dt>
                    <dd class="col-sm-8">@(Model.Note ?? "—")</dd>

                    <dt class="col-sm-4">Tổng tiền</dt>
                    <dd class="col-sm-8"><strong>@Model.TotalAmount.ToString("N0") đ</strong></dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-12 mt-3">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Sản phẩm trong đơn</h3>
            </div>
            <div class="card-body table-responsive p-0">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Sản phẩm</th>
                            <th class="text-center">SL</th>
                            <th class="text-right">Đơn giá</th>
                            <th class="text-right">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Model.OrderDetails)
                        {
                            <tr>
                                <td>@line.ProductName</td>
                                <td class="text-center">@line.Quantity</td>
                                <td class="text-right">@line.UnitPrice.ToString("N0") đ</td>
                                <td class="text-right">@line.LineTotal.ToString("N0") đ</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<p class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Sửa</a>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</p>
