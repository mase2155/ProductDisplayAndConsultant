@model OrderFormModel
@{
    var products = ViewBag.ProductList as List<Product> ?? new List<Product>();
}

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="form-group">
    <label asp-for="CustomerId"></label>
    <select asp-for="CustomerId" asp-items="ViewBag.CustomerId" class="form-control"></select>
    <span asp-validation-for="CustomerId" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-6 form-group">
        <label asp-for="OrderDate"></label>
        <input asp-for="OrderDate" type="datetime-local" class="form-control"
               value="@Model.OrderDate.ToString("yyyy-MM-ddTHH:mm")" />
        <span asp-validation-for="OrderDate" class="text-danger"></span>
    </div>
    <div class="col-md-6 form-group">
        <label asp-for="Status"></label>
        <select asp-for="Status" asp-items="ViewBag.StatusList" class="form-control"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
</div>

<div class="form-group">
    <label asp-for="Phone"></label>
    <input asp-for="Phone" class="form-control" />
    <span asp-validation-for="Phone" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="ShippingAddress"></label>
    <textarea asp-for="ShippingAddress" class="form-control" rows="2"></textarea>
    <span asp-validation-for="ShippingAddress" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="Note"></label>
    <textarea asp-for="Note" class="form-control" rows="2"></textarea>
    <span asp-validation-for="Note" class="text-danger"></span>
</div>

<hr />
<h5>Chi tiết sản phẩm</h5>
<p class="text-muted small">Chọn sản phẩm và số lượng (bỏ trống dòng không dùng).</p>

@for (int i = 0; i < Model.Details.Count; i++)
{
    <div class="row align-items-end mb-2">
        <div class="col-md-8">
            <label>Sản phẩm @(i + 1)</label>
            <select asp-for="Details[i].ProductId" class="form-control">
                <option value="0">-- Chọn sản phẩm --</option>
                @foreach (var product in products)
                {
                    if (Model.Details[i].ProductId == product.Id)
                    {
                        <option value="@product.Id" selected="selected">@product.Name — @((product.NewPrice ?? product.Price).ToString("N0")) đ</option>
                    }
                    else
                    {
                        <option value="@product.Id">@product.Name — @((product.NewPrice ?? product.Price).ToString("N0")) đ</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-4">
            <label asp-for="Details[i].Quantity"></label>
            <input asp-for="Details[i].Quantity" class="form-control" min="1" />
            <span asp-validation-for="Details[i].Quantity" class="text-danger"></span>
        </div>
    </div>
}
